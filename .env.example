# Copie para .env antes de subir os servicos: cp .env.example .env

# ---- Banco de dados ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=challenge
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/challenge?schema=public

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tech-challenge
KAFKA_GROUP_ID_TRANSACTIONS=transactions-consumer
KAFKA_GROUP_ID_ANTI_FRAUD=anti-fraud-consumer

# ---- Portas das aplicacoes ----
TRANSACTIONS_PORT=3001
ANTI_FRAUD_PORT=3002

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Limites de negocio ----
# Number.MAX_SAFE_INTEGER, nao o limite literal da coluna `value` (NUMERIC(18,2), que aceita ate
# 9999999999999999.99 — ver DECISIONS.md "Modelagem de dados da transacao"). Esse literal nao e
# seguro como limite: Number('9999999999999999.99') arredonda pra CIMA pra exatamente 1e16 (doubles
# perdem precisao decimal nessa magnitude), e 1e16 e maior ou igual ao teto da coluna — validacao
# deixava passar um valor que o Postgres rejeitava com 500 (nao 400). MAX_SAFE_INTEGER e o maior
# inteiro que um double representa sem arredondamento, com folga confortavel abaixo do teto real
# da coluna.
# As duas variaveis precisam do MESMO valor: a de backend valida no servidor (defesa real), a
# NEXT_PUBLIC_ so existe pro form barrar no navegador com mensagem de campo em vez do erro
# generico do backend.
TRANSACTION_VALUE_MAX=9007199254740991
NEXT_PUBLIC_TRANSACTION_VALUE_MAX=9007199254740991

# ---- Retentativa de transacoes pendentes ----
# O job varre a cada 1 minuto (fixo, ver comentario em pending-transactions-retry.job.ts) e
# reemite transaction.created para pendentes mais antigas que PENDING_RETRY_THRESHOLD_MINUTES
# (cobre tanto falha na publicacao original quanto falha no anti-fraud/na resposta dele — ver
# DECISIONS.md "Retentativa de transacoes pendentes"). PENDING_RETRY_BATCH_SIZE limita quantas
# linhas uma unica varredura reivindica por vez.
PENDING_RETRY_THRESHOLD_MINUTES=10
PENDING_RETRY_BATCH_SIZE=50
